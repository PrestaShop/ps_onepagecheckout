        <target>Zobaczysz dostępne metody dostawy po wpisaniu adresu dostawy.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.payment_methods_after_address">
        <source>You will see the available payment methods once you've entered your delivery address.</source>
        <target>Zobaczysz dostępne metody płatności po wpisaniu adresu dostawy.</target>
