        <target>Napisz komentarz do tego zamówienia</target>
      </trans-unit>
      <trans-unit id="psopc.shop.order_comment_placeholder">
        <source>Write your comment...</source>
        <target>Napisz swój komentarz...</target>
      </trans-unit>
